<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINSKA"
            android:textColor="#123C2D"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="Android testversion 0.1"
            android:textColor="#607069"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Idag"
            android:textColor="#111111"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/monsterButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:text="Monster   0 / 1   +1"
            android:textSize="18sp" />

        <Button
            android:id="@+id/sodaButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Läsk   0 / 500 ml   +250 ml"
            android:textSize="18sp" />

        <Button
            android:id="@+id/chocolateButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Choklad   0 / 100 g   +25 g"
            android:textSize="18sp" />

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:text="+ Lägg till eget mål" />

        <Button
            android:id="@+id/notificationButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="Testa notis" />

        <Button
            android:id="@+id/gpsButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="Aktivera GPS" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#E3F2E9"
            android:padding="18dp"
            android:text="AI-demo: Monster trappas ner försiktigare eftersom det innehåller koffein. Riktig AI kopplas på senare."
            android:textColor="#123C2D"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
